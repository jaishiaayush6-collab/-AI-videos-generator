# Copy this file to .env and add your own API keys.
# Never put these keys in public/ or browser JavaScript.

PORT=3000
NODE_ENV=development
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

REPLICATE_API_TOKEN=

# Set the Replicate model slug (owner/name) for each media generator.
# The input JSON templates below are examples. Model input names vary by model.
REPLICATE_MODEL_VIDEO=
REPLICATE_MODEL_MOVIE=
REPLICATE_MODEL_IMAGE_VIDEO=
REPLICATE_MODEL_SONG=
REPLICATE_MODEL_IMAGE_SONG=

# JSON input templates. Supported placeholders: {{prompt}}, {{image}}, {{duration}}, {{aspectRatio}}.
# Adjust keys to match the exact input schema of the Replicate model you choose.
REPLICATE_INPUT_VIDEO={"prompt":"{{prompt}}","duration":5,"aspect_ratio":"16:9"}
REPLICATE_INPUT_MOVIE={"prompt":"{{prompt}}","duration":10,"aspect_ratio":"16:9"}
REPLICATE_INPUT_IMAGE_VIDEO={"prompt":"{{prompt}}","image":"{{image}}","duration":5}
REPLICATE_INPUT_SONG={"prompt":"{{prompt}}"}
REPLICATE_INPUT_IMAGE_SONG={"prompt":"{{prompt}}","image":"{{image}}"}

# Optional: comma-separated origins allowed to call the API.
# Leave blank to allow same-origin requests only.
CORS_ORIGINS=
