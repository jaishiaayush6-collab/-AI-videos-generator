# Copy this file to .env, then add credentials from the official provider dashboards.
# NEVER paste real keys into HTML/JavaScript or commit .env to GitHub.
PORT=3000
NODE_ENV=development

# OpenAI: text/story/editor, image generation, and text-to-speech
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# Replicate: video and music. Configure only models you actually have access to.
REPLICATE_API_TOKEN=
REPLICATE_MODEL_VIDEO=
REPLICATE_MODEL_MOVIE=
REPLICATE_MODEL_IMAGE_VIDEO=
REPLICATE_MODEL_SONG=
REPLICATE_MODEL_IMAGE_SONG=

# IMPORTANT: Input fields differ by Replicate model. These are examples only.
# Edit each JSON template to match the selected model's Input schema.
REPLICATE_INPUT_VIDEO={"prompt":"{{prompt}}","duration":5,"aspect_ratio":"16:9"}
REPLICATE_INPUT_MOVIE={"prompt":"{{prompt}}","duration":10,"aspect_ratio":"16:9"}
REPLICATE_INPUT_IMAGE_VIDEO={"prompt":"{{prompt}}","image":"{{image}}","duration":5}
REPLICATE_INPUT_SONG={"prompt":"{{prompt}}"}
REPLICATE_INPUT_IMAGE_SONG={"prompt":"{{prompt}}","image":"{{image}}"}

# Optional comma-separated allowed browser origins. Leave blank for same-origin use.
CORS_ORIGINS=
