PORT=3000
NODE_ENV=development
# Firebase Admin service account JSON as one line, OR use GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=
# Your chosen AI provider's server-side endpoint and secret. Keep these on server only.
AI_PROVIDER_URL=
AI_PROVIDER_API_KEY=
# Comma-separated allowed origins; leave blank for same-origin local use
ALLOWED_ORIGINS=
MAX_UPLOAD_MB=20
